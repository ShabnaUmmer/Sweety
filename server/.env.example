# Copy this file to server/.env and fill in the values. Never commit .env.

# --- Required ---
# Main database (the one `npm run db:migrate` and `npm run db:seed` use)
DATABASE_URL=postgres://sweety_user:your_password@localhost:5432/sweety
# Separate database used only by `npm test`. Its tables are emptied on every run.
TEST_DATABASE_URL=postgres://sweety_user:your_password@localhost:5432/sweety_test
# Long random string used to sign login tokens, for example: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# --- Optional (defaults shown) ---
PORT=4000
# IANA time zone that decides what "today" means for the future-date check and report ranges
APP_TIMEZONE=Asia/Kolkata
# How long a login lasts (30m, 2h, 7d ...)
JWT_EXPIRES_IN=2h
# Browser origins allowed to call the API directly (comma-separated)
CLIENT_ORIGIN=http://localhost:5173
